# Virtual environment
.venv/
env/
venv/

# Python cache & artifacts
__pycache__/
*.py[cod]
*.swp
*.swo
.DS_Store

# Audio and temporary cache & logs
*.wav
*.pcm
*.log
coach_server.log
data/logs/*
!data/logs/.gitkeep

# Sensitive environment configuration
.env
.env.local
*cookies*.txt
data/*cookies*.txt

# Local model weights (Download via `bash scripts/download_models.sh`)
models/*
!models/.gitkeep

# Large copyrighted books, user custom uploads & media
data/books/*
!data/books/.gitkeep
data/custom_books/*
!data/custom_books/.gitkeep
data/custom_pdfs/
data/custom_docs.json
data/media/*
!data/media/.gitkeep

# Persistent local databases & user runtime states
data/*.db
data/*.db-*
data/model-runtime/*
!data/model-runtime/.gitkeep
data/backups/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
