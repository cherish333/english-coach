# =========================================================
# AI English Coach Configuration
# =========================================================

# LLM Backend (Default: Local Qwen 3.8-27B on port 18020)
QWEN_BASE_URL=http://127.0.0.1:18020/v1
QWEN_API_KEY=EMPTY
QWEN_MODEL_NAME=qwen3.8-27b

# Inference Parameters
LLM_MAX_NEW_TOKENS=256
LLM_TEMPERATURE=0.7
ENABLE_THINKING=false

# Audio & Voice Defaults
# Voices: af_maple/af_sol (US English), bf_vale (UK English), zf_* (Chinese Female), zm_* (Chinese Male)
DEFAULT_VOICE=af_maple
DEFAULT_SPEED=1.0
MAX_HISTORY_TURNS=12

# Server Port
SERVER_HOST=127.0.0.1
SERVER_PORT=8765

# Textbooks for lecture mode (optional overrides, defaults to data/books/)
# VOCABULARY_PDF=/path/to/your/vocabulary_in_use.pdf
# GRAMMAR_PDF=/path/to/your/grammar_in_use.pdf
# WESTERN_CIV_PDF=/path/to/your/western_civilization.pdf

# Frontend model lifecycle (optional; local defaults auto-detected)
# QWEN_COMPOSE_DIR=/path/to/qwen-docker-compose
# MINICPM_LLAMA_SERVER=/path/to/llama.cpp/llama-server
# MINICPM_MODEL_PATH=/path/to/MiniCPM-GGUF/model.gguf
MINICPM_PORT=18021

# Bonsai Configuration (Ternary-Bonsai-2-27B via Unsloth / llama.cpp-prism)
# BONSAI_BASE_URL=http://127.0.0.1:18022/v1
# BONSAI_API_KEY=EMPTY
# BONSAI_MODEL_NAME=prism-ml/Ternary-Bonsai-2-27B-gguf
BONSAI_PORT=18022
# BONSAI_MODEL_PATH=/path/to/Ternary-Bonsai-2-27B-PQ2_0.gguf
# BONSAI_LLAMA_SERVER=/path/to/llama.cpp-prism/llama-server
# BONSAI_MMPROJ_PATH=/path/to/Ternary-Bonsai-2-27B-mmproj-BF16.gguf
# BONSAI_LORA_PATH=/path/to/adapters/bonsai-abliterate-lora.gguf
# BONSAI_LORA_SCALE=2.0
# BONSAI_CTX_SIZE=16384

MODEL_START_TIMEOUT=900

# YouTube Subtitle & Importer Configuration (optional)
# YOUTUBE_COOKIES_FILE=data/youtube_cookies.txt
# YOUTUBE_BROWSER=chromium

# Translation & Word Glosses Engine Configuration
# Options: auto (DeepL for sentences, NVIDIA/local for glosses), deepl, nvidia, local
TRANSLATION_ENGINE=auto
# DEEPL_API_KEY=your-deepl-api-key:fx
# NVIDIA_API_KEY=nvapi-your-key
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=qwen/qwen2.5-72b-instruct

